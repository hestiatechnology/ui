{
  "name": "hestia-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "audit:material": "node tools/material-audit.cjs projects/hestia-ui/src",
    "lint:material": "node tools/material-audit.cjs projects/hestia-ui/src --fail-on-match",
    "storybook": "ng run hestia-ui:storybook",
    "build-storybook": "ng run hestia-ui:build-storybook",
    "compodoc": "ng run hestia-ui:compodoc",
    "compodoc:serve": "compodoc -p projects/hestia-ui/tsconfig.lib.json -d dist/compodoc/hestia-ui --serve"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/aria": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@lucide/angular": "^1.33.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.5",
    "@angular-devkit/core": "^22.1.5",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/angular": "^10.5.10",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
